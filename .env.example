# PawCast Optional Firebase Auth & Cloud Firestore Sync Configuration
# Copy this file to `.env.local` for local development (never commit `.env.local`).
# For GitHub Pages deployments, add these same names under:
#   GitHub Repo -> Settings -> Secrets and variables -> Actions -> Variables
#
# Leave blank to run PawCast in 100% local Guest Mode.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional Firebase metadata fields:
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
