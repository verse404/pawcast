rules_version = '2';

// PawCast Cloud Firestore Security Rules (Schema v1 & v2 + Co-Walker Households)
// Enforces strict per-user isolation, explicit field allow-lists, bounded document sizes,
// and non-enumerable 192-bit cryptographic invite tokens for optional household sharing.
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Personal User Profile, Preferences, Secret Spots, Care Reminders & Gear Checklist
    match /users/{userId}/pawcast/profile {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'updatedAtMs',
          'units',
          'language',
          'savedPlaceIds',
          'spotNotes',
          'dogs',
          'activeDogIds',
          'walkLogs',
          'location',
          'memberProfile',
          'memberPreferences',
          'customSpots',
          'careReminders',
          'gearChecklist',
          'householdId'
        ])
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.updatedAtMs is int
        && request.resource.data.units in ['metric', 'imperial']
        && request.resource.data.language in ['en', 'zh']
        && request.resource.data.dogs is list
        && request.resource.data.dogs.size() >= 1
        && request.resource.data.dogs.size() <= 5
        && request.resource.data.activeDogIds is list
        && request.resource.data.activeDogIds.size() <= 5
        && request.resource.data.savedPlaceIds is list
        && request.resource.data.savedPlaceIds.size() <= 50
        && request.resource.data.walkLogs is list
        && request.resource.data.walkLogs.size() <= 100
        && request.resource.data.spotNotes is map
        && request.resource.data.spotNotes.size() <= 60
        && request.resource.data.location is map
        && (!('memberProfile' in request.resource.data) || request.resource.data.memberProfile is map)
        && (!('memberPreferences' in request.resource.data) || request.resource.data.memberPreferences is map)
        && (!('customSpots' in request.resource.data) || (request.resource.data.customSpots is list && request.resource.data.customSpots.size() <= 20))
        && (!('careReminders' in request.resource.data) || (request.resource.data.careReminders is list && request.resource.data.careReminders.size() <= 12))
        && (!('gearChecklist' in request.resource.data) || (request.resource.data.gearChecklist is list && request.resource.data.gearChecklist.size() <= 15))
        && (!('householdId' in request.resource.data) || request.resource.data.householdId == null || (request.resource.data.householdId is string && request.resource.data.householdId.size() <= 64));
    }

    // 2. Cryptographically Random Single-Use Household Invite Tokens (No Enumeration)
    match /householdInvites/{inviteToken} {
      allow list: if false;
      allow get: if request.auth != null
        && inviteToken.size() >= 36;
      allow create: if request.auth != null
        && inviteToken.size() >= 36
        && request.resource.data.keys().hasOnly([
          'householdId',
          'ownerUid',
          'ownerName',
          'createdAtMs',
          'expiresAtMs'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.householdId is string
        && request.resource.data.ownerName is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.expiresAtMs is int;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || request.time.toMillis() <= resource.data.expiresAtMs);
    }

    // 3. Shared Household / Co-Walker Pack & Walk Journal (Up to 4 Caretakers)
    match /households/{householdId} {
      allow list: if false;
      allow get: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'memberUids',
          'memberLabels',
          'dogs',
          'activeDogIds',
          'savedPlaceIds',
          'walkLogs',
          'careReminders',
          'lastJoinToken',
          'updatedAtMs'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.dogs is list
        && request.resource.data.dogs.size() >= 1
        && request.resource.data.dogs.size() <= 5
        && request.resource.data.savedPlaceIds is list
        && request.resource.data.savedPlaceIds.size() <= 50
        && request.resource.data.walkLogs is list
        && request.resource.data.walkLogs.size() <= 100
        && request.resource.data.careReminders is list
        && request.resource.data.careReminders.size() <= 12;

      allow update: if request.auth != null
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 1
        && request.resource.data.memberUids.size() <= 4
        && request.resource.data.dogs is list
        && request.resource.data.dogs.size() >= 1
        && request.resource.data.dogs.size() <= 5
        && request.resource.data.savedPlaceIds is list
        && request.resource.data.savedPlaceIds.size() <= 50
        && request.resource.data.walkLogs is list
        && request.resource.data.walkLogs.size() <= 100
        && request.resource.data.careReminders is list
        && request.resource.data.careReminders.size() <= 12
        && (
          // Existing member updating shared dogs/logs or leaving
          request.auth.uid in resource.data.memberUids
          || (
            // New co-walker joining with a valid, unexpired 192-bit invite token
            request.resource.data.lastJoinToken is string
            && request.resource.data.lastJoinToken.size() >= 36
            && exists(/databases/$(database)/documents/householdInvites/$(request.resource.data.lastJoinToken))
            && get(/databases/$(database)/documents/householdInvites/$(request.resource.data.lastJoinToken)).data.householdId == householdId
            && request.time.toMillis() <= get(/databases/$(database)/documents/householdInvites/$(request.resource.data.lastJoinToken)).data.expiresAtMs
            && request.auth.uid in request.resource.data.memberUids
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          )
        );

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Default-deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
